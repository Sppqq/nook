#!/usr/bin/env python3
"""Ephemeral credentials for github-git; never stores or erases host credentials."""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from tools.github_setup import read_token

if sys.argv[1:] == ['get']:
    fields = dict(line.rstrip('\n').split('=', 1) for line in sys.stdin if '=' in line)
    if fields.get('protocol') == 'https' and fields.get('host') == 'github.com':
        token = read_token(Path(__file__).resolve().parents[1])
        if token:
            print('username=x-access-token\npassword=' + token)
