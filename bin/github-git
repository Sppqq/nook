#!/usr/bin/env python3
"""Git using this Nook's GitHub token and commit identity, without global changes."""
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys

home = Path(__file__).resolve().parents[1]
try:
    identity = json.loads((home / 'config.json').read_text())['github']
    login, email = identity['login'], identity['email']
except (OSError, ValueError, KeyError):
    sys.exit('Сначала подключи GitHub: install.py --github-only.')
env = dict(os.environ, GIT_TERMINAL_PROMPT='0', GIT_ASKPASS='/bin/false')
# Explicit environment identity would otherwise override git -c user.*.
for key in ('GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL', 'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL'):
    env.pop(key, None)
sys.exit(subprocess.call(['git', '-c', 'credential.helper=', '-c',
    'credential.helper=!' + shlex.quote(str(home / 'bin/github-credential')),
    '-c', 'user.name=' + login, '-c', 'user.email=' + email, *sys.argv[1:]], env=env))
