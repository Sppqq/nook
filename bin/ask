#!/usr/bin/env python3
"""ask "Вопрос?" "Вариант 1" "Вариант 2" ... — спросить хозяина в Telegram с кнопками-вариантами.
Ответ (нажатая кнопка) придёт тебе следующим сообщением в этот же разговор. Не жди его — закончи ход.
Варианты короткие (до ~30 символов), 2–6 штук."""
import json, os, sys, time, uuid

HOME = os.environ.get("NOOK_HOME", os.path.expanduser("~/nook"))
SPOOL = os.path.join(HOME, "spool", "outbox")
args = sys.argv[1:]
if len(args) < 3 or args[0] in ("-h", "--help"):
    print(__doc__); sys.exit(0 if args[:1] in (["-h"], ["--help"]) else 1)
question, options = args[0], [o[:60] for o in args[1:9]]
os.makedirs(SPOOL, exist_ok=True)
name = f"{time.time():.6f}-{uuid.uuid4().hex[:6]}"
item = {"text": question, "options": options, "run": os.environ.get("NOOK_RUN")}
with open(os.path.join(SPOOL, name + ".tmp"), "w") as f:
    json.dump(item, f, ensure_ascii=False)
os.rename(os.path.join(SPOOL, name + ".tmp"), os.path.join(SPOOL, name + ".json"))
print("вопрос отправлен; ответ придёт следующим сообщением — сейчас закончи ход")
