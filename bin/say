#!/usr/bin/env python3
"""say "текст" | say --file PATH "подпись" | say --photo PATH "подпись" — сообщение хозяину в Telegram."""
import json, os, sys, time, uuid

SPOOL = os.path.join(os.environ.get("NOOK_HOME", os.path.expanduser("~/nook")), "spool", "outbox")
args = sys.argv[1:]
file, photo = None, False
if args[:1] in (["--file"], ["--photo"]):
    photo = args[0] == "--photo"
    if len(args) < 2:
        sys.exit("usage: say --file|--photo PATH [caption]")
    file = os.path.abspath(args[1])
    if not os.path.isfile(file):
        sys.exit(f"нет файла: {file}")
    args = args[2:]
text = " ".join(args) if args else ("" if file else sys.stdin.read())
if not text.strip() and not file:
    sys.exit('usage: say "текст"')
os.makedirs(SPOOL, exist_ok=True)
name = f"{time.time():.6f}-{uuid.uuid4().hex[:6]}"
tmp = os.path.join(SPOOL, name + ".tmp")
with open(tmp, "w") as f:
    json.dump({"text": text, "file": file, "photo": photo}, f, ensure_ascii=False)
os.rename(tmp, os.path.join(SPOOL, name + ".json"))
print("отправлено в очередь")
