#!/usr/bin/python3 -I
"""nook-root ID — выполнить от root команду из запроса Nook, если хозяин её одобрил
(кнопка «Выполнить» в Telegram) или включён режим полного доступа.

Ставится root-владельцем в /usr/local/sbin; sudo разрешает владельцу запускать только его.
Каждый запуск пишется в /var/log/nook-root.log (root-only, агент не может его стереть).
"""
import json, os, re, stat, subprocess, sys, time, uuid

BASE = "__NOOK_USER_HOME__/nook/spool/root"
LOG = "/var/log/nook-root.log"
CLAIMS = "/var/lib/nook-root-claims"
OWNER_UID = int('__NOOK_UID__')
APPROVAL_TTL = 15 * 60    # одобрение действует 15 минут


def log(msg):
    fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    os.write(fd, (time.strftime("%Y-%m-%d %H:%M:%S ") + msg.replace("\n", "\\n") + "\n").encode())
    os.close(fd)


def read_json(directory, name):
    """Читаем только обычный файл владельца, без симлинков."""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != OWNER_UID or st.st_nlink != 1:
            raise PermissionError(name)
        data = f.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise ValueError("request is too large")
        return json.loads(data)


def write_json(directory, name, data):
    temporary = ".nook-root-" + uuid.uuid4().hex
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, ensure_ascii=False)
            f.flush()
            os.fchown(f.fileno(), OWNER_UID, OWNER_UID)
            os.fsync(f.fileno())
        os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def claim_once(rid):
    try:
        os.mkdir(CLAIMS, 0o700)
        parent = os.open(os.path.dirname(CLAIMS), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    except FileExistsError:
        pass
    directory = os.open(CLAIMS, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(directory)
        if info.st_uid != os.geteuid() or info.st_mode & 0o077:
            raise PermissionError("unsafe root claim directory")
        try:
            fd = os.open(f"{OWNER_UID}-{rid}", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600, dir_fd=directory)
        except FileExistsError:
            return False
        with os.fdopen(fd, "w") as claim:
            claim.write(str(int(time.time())) + "\n")
            claim.flush()
            os.fsync(claim.fileno())
        os.fsync(directory)
        return True
    finally:
        os.close(directory)


def main():
    if len(sys.argv) != 2 or not re.fullmatch(r"[a-f0-9]{8,32}", sys.argv[1]):
        sys.exit("usage: nook-root ID")
    rid = sys.argv[1]
    directory = os.open(BASE, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        if os.fstat(directory).st_uid != OWNER_UID:
            sys.exit("bad spool dir")
        execute_request(directory, rid)
    finally:
        os.close(directory)


def execute_request(directory, rid):
    name = rid + ".json"
    req = read_json(directory, name)
    now = time.time()
    try:
        full = read_json(directory, "full.json").get("until", 0) > now
    except (FileNotFoundError, PermissionError, ValueError):
        full = False
    approved = req.get("approved") and 0 <= now - req.get("approved_at", 0) < APPROVAL_TTL
    if req.get("done"):
        sys.exit("уже выполнено")
    if not (approved or full):
        log(f"DENIED {rid} (не одобрено) cmd={req.get('cmd')!r}")
        sys.exit("не одобрено хозяином")
    if not claim_once(rid):
        sys.exit("этот запрос уже был принят; проверь результат перед повтором")
    mode = "approved" if approved else "full"
    req["done"] = True
    write_json(directory, name, req)
    log(f"RUN {rid} mode={mode} reason={req.get('reason')!r} cmd={req['cmd']!r}")
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root",
           "LANG": "C.UTF-8", "DEBIAN_FRONTEND": "noninteractive"}
    try:
        p = subprocess.run(["/bin/bash", "-c", req["cmd"]], capture_output=True, text=True, env=env,
                           timeout=int(req.get("timeout", 600)), cwd="/root", stdin=subprocess.DEVNULL)
        code, out = p.returncode, (p.stdout + p.stderr)
    except subprocess.TimeoutExpired as e:
        code, out = 124, f"таймаут {e.timeout}s\n" + ((e.stdout or "") + (e.stderr or "") if isinstance(e.stdout, str) else "")
    log(f"EXIT {rid} code={code}")
    write_json(directory, rid + ".result.json", {"code": code, "output": out[-20000:], "mode": mode})
    sys.stdout.write(out[-20000:])
    sys.exit(code)


if __name__ == "__main__":
    main()
